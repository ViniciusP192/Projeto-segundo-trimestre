@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --texto: #172033;
    --branco: #ffffff;
    --cinza: #64748b;
    --fundo: #f8fafc;

    --azul: #2563eb;
    --azul-escuro: #172554;

    --verde: #22c55e;
    --verde-escuro: #052e16;

    --roxo: #8b5cf6;
    --roxo-escuro: #2e1065;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Inter', sans-serif;
    background: var(--fundo);
    color: var(--texto);
    line-height: 1.7;
}


/* ==================================================
   BARRA DE NAVEGAÇÃO
   ================================================== */

header {
    position: sticky;
    top: 0;
    z-index: 1000;

    height: 76px;

    padding: 0 6%;

    display: flex;
    justify-content: space-between;
    align-items: center;

    background: rgba(255, 255, 255, 0.92);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
}


/* LOGO */

.logo {
    font-family: 'Space Grotesk', sans-serif;

    font-size: 20px;
    font-weight: 700;

    color: var(--azul-escuro);

    white-space: nowrap;
}


/* MENU */

nav {
    display: flex;
    align-items: center;
    gap: 8px;
}

nav a {
    position: relative;

    text-decoration: none;

    color: #475569;

    font-weight: 600;

    padding: 10px 18px;

    border-radius: 12px;

    transition: 0.25s ease;
}


/* efeito quando passa o mouse */

nav a:hover {
    color: var(--azul);
    background: #eff6ff;

    transform: translateY(-2px);
}


/* página atual */

nav a.ativo {
    color: white;

    background: linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
    );

    box-shadow:
        0 5px 15px rgba(37, 99, 235, 0.25);
}


/* ==================================================
   HERO
   ================================================== */

.hero {
    min-height: 500px;

    padding: 80px 8%;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 50px;

    color: white;

    position: relative;

    overflow: hidden;
}


/* círculos decorativos */

.hero::before {
    content: "";

    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    background: rgba(255,255,255,0.06);

    right: -100px;
    top: -150px;
}

.hero::after {
    content: "";

    position: absolute;

    width: 300px;
    height: 300px;

    border-radius: 50%;

    background: rgba(255,255,255,0.05);

    left: -100px;
    bottom: -150px;
}


.hero > div {
    position: relative;

    z-index: 2;
}


.hero > div:first-child {
    max-width: 720px;
}


.etiqueta {
    display: inline-block;

    padding: 7px 14px;

    border-radius: 30px;

    background: rgba(255,255,255,0.14);

    border: 1px solid rgba(255,255,255,0.2);

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 1.2px;

    margin-bottom: 20px;
}


.hero h1 {
    font-family: 'Space Grotesk', sans-serif;

    font-size: clamp(40px, 6vw, 72px);

    line-height: 1.02;

    margin-bottom: 24px;
}


.hero p {
    max-width: 680px;

    font-size: 18px;

    color: rgba(255,255,255,0.85);
}


.hero-icon,
.bola,
.robo {
    font-size: 150px;

    animation: flutuar 4s ease-in-out infinite;

    filter:
        drop-shadow(
            0 20px 30px rgba(0,0,0,0.3)
        );
}


@keyframes flutuar {

    0%, 100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-15px);
    }
}


/* ==================================================
   CORES ESPECÍFICAS DAS PÁGINAS
   ================================================== */


/* VISÃO */

body:has(.hero:not(.hero-verde):not(.hero-robo)) .hero {
    background:
        radial-gradient(
            circle at 80% 20%,
            #6366f1,
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #172554,
            #2563eb
        );
}


/* TRIONDA */

.hero-verde {
    background:
        radial-gradient(
            circle at 80% 20%,
            #22c55e,
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #022c22,
            #15803d
        );
}


/* ROBÓTICA */

.hero-robo {
    background:
        radial-gradient(
            circle at 80% 20%,
            #06b6d4,
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #2e1065,
            #6d28d9
        );
}


/* ==================================================
   CONTEÚDO
   ================================================== */

.conteudo,
.curiosidades,
.projetos {

    width: min(1150px, 88%);

    margin: 70px auto;
}


/* ==================================================
   CARDS DA PÁGINA DE VISÃO
   ================================================== */

.card {

    background: white;

    padding: 38px;

    border-radius: 22px;

    margin-bottom: 25px;

    border: 1px solid #e2e8f0;

    box-shadow:
        0 10px 35px rgba(15,23,42,0.06);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
}


.card:hover {

    transform: translateY(-5px);

    box-shadow:
        0 18px 45px rgba(37,99,235,0.10);
}


.card h2 {

    font-family: 'Space Grotesk', sans-serif;

    color: var(--azul-escuro);

    font-size: 27px;

    margin-bottom: 15px;
}


.card p {

    color: var(--cinza);

    margin-bottom: 15px;
}


/* ==================================================
   FENÔMENOS ÓPTICOS
   ================================================== */

.fenomenos {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 18px;

    margin-top: 25px;
}


.fenomenos > div {

    padding: 25px;

    background:
        linear-gradient(
            135deg,
            #f8fafc,
            #eff6ff
        );

    border-radius: 17px;

    border: 1px solid #dbeafe;

    transition: 0.3s;
}


.fenomenos > div:hover {

    transform: scale(1.02);

    border-color: #93c5fd;
}


.fenomenos span {

    font-size: 34px;
}


.fenomenos h3 {

    margin: 8px 0;

    color: #1e3a8a;
}


.fenomenos p {

    font-size: 14px;
}


/* ==================================================
   DESTAQUES
   ================================================== */

.destaque {

    margin-top: 22px;

    padding: 20px;

    background: #eff6ff;

    border-left: 5px solid var(--azul);

    border-radius: 12px;

    color: #334155;
}


.alerta {

    margin-top: 22px;

    padding: 20px;

    background: #fff7ed;

    border-left: 5px solid #f97316;

    border-radius: 12px;
}


/* ==================================================
   TRIONDA
   ================================================== */

.curiosidades {

    max-width: 1000px;
}


.curiosidade {

    position: relative;

    background: white;

    border-radius: 24px;

    padding: 40px;

    display: grid;

    grid-template-columns: 90px 1fr;

    gap: 30px;

    margin-bottom: 28px;

    border: 1px solid #dcfce7;

    box-shadow:
        0 10px 35px rgba(22,101,52,0.07);

    overflow: hidden;

    transition: 0.3s;
}


.curiosidade::before {

    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 5px;

    background:
        linear-gradient(
            #22c55e,
            #15803d
        );
}


.curiosidade:hover {

    transform: translateX(6px);

    box-shadow:
        0 18px 45px rgba(22,163,74,0.12);
}


.numero {

    font-family: 'Space Grotesk', sans-serif;

    font-size: 45px;

    font-weight: 800;

    color: #16a34a;
}


.curiosidade h2 {

    font-family: 'Space Grotesk', sans-serif;

    font-size: 28px;

    color: #14532d;

    margin-bottom: 12px;
}


.curiosidade p {

    color: #64748b;

    margin-bottom: 15px;
}


.curiosidade .destaque {

    background: #f0fdf4;

    border-left-color: #16a34a;
}


/* ==================================================
   FÓRMULA
   ================================================== */

.formula {

    display: inline-block;

    padding: 13px 22px;

    margin: 15px 0;

    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    border-radius: 12px;

    color: #15803d;

    font-size: 21px;

    font-weight: 700;
}


/* ==================================================
   TRAJETÓRIA DA BOLA
   ================================================== */

.trajetoria {

    display: flex;

    justify-content: center;

    align-items: center;

    gap: 25px;

    margin-top: 30px;

    font-size: 35px;
}


.linha {

    width: 200px;

    height: 70px;

    border-top: 4px solid #22c55e;

    border-radius: 50%;

    transform: rotate(-10deg);
}


/* ==================================================
   ROBÓTICA
   ================================================== */

.projetos {

    display: grid;

    grid-template-columns:
        repeat(2, 1fr);

    gap: 25px;
}


.projeto,
.novo-projeto {

    position: relative;

    background: white;

    padding: 35px;

    border-radius: 22px;

    border: 1px solid #e9d5ff;

    box-shadow:
        0 10px 35px rgba(76,29,149,0.08);

    transition: 0.3s;
}


.projeto:hover {

    transform:
        translateY(-8px)
        rotate(0.5deg);

    box-shadow:
        0 20px 45px rgba(124,58,237,0.15);
}


.icone {

    width: 75px;
    height: 75px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 18px;

    background:
        linear-gradient(
            135deg,
            #ede9fe,
            #cffafe
        );

    font-size: 42px;

    margin-bottom: 20px;
}


.projeto h2,
.novo-projeto h2 {

    font-family: 'Space Grotesk', sans-serif;

    color: #4c1d95;

    margin-bottom: 12px;
}


.projeto p,
.novo-projeto p {

    color: #64748b;
}


.tag {

    display: inline-block;

    margin: 18px 5px 0 0;

    padding: 6px 11px;

    border-radius: 20px;

    background: #f3e8ff;

    color: #7e22ce;

    font-size: 12px;

    font-weight: 700;
}


/* ==================================================
   CARD PARA NOVO PROJETO
   ================================================== */

.novo-projeto {

    background:
        linear-gradient(
            135deg,
            #faf5ff,
            #ecfeff
        );

    border:
        2px dashed #8b5cf6;
}


button {

    border: none;

    padding: 13px 22px;

    margin-top: 18px;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            #7c3aed,
            #0891b2
        );

    color: white;

    font-weight: 700;

    cursor: pointer;

    transition: 0.3s;
}


button:hover {

    transform:
        translateY(-3px);

    box-shadow:
        0 10px 25px rgba(124,58,237,0.25);
}


#mensagem {

    margin-top: 15px;

    color: #6d28d9;

    font-weight: 600;
}


/* ==================================================
   RODAPÉ
   ================================================== */

footer {

    margin-top: 90px;

    padding: 35px;

    text-align: center;

    color: #94a3b8;

    background: #0f172a;
}


/* ==================================================
   RESPONSIVIDADE
   ================================================== */

@media (max-width: 800px) {

    header {

        height: auto;

        min-height: 75px;

        padding:
            15px 5%;

        gap: 15px;

        flex-direction: column;
    }


    nav {

        width: 100%;

        justify-content: center;

        flex-wrap: wrap;
    }


    nav a {

        padding:
            8px 12px;

        font-size: 14px;
    }


    .hero {

        min-height: 500px;

        padding:
            65px 7%;

        text-align: center;

        flex-direction: column;

        justify-content: center;
    }


    .hero-icon,
    .bola,
    .robo {

        font-size: 90px;
    }


    .fenomenos {

        grid-template-columns: 1fr;
    }


    .projetos {

        grid-template-columns: 1fr;
    }


    .curiosidade {

        grid-template-columns: 1fr;

        padding: 30px;
    }


    .numero {

        font-size: 35px;
    }
}


@media (max-width: 500px) {

    .hero h1 {

        font-size: 40px;
    }


    .hero p {

        font-size: 16px;
    }


    .card,
    .curiosidade,
    .projeto,
    .novo-projeto {

        padding: 25px;
    }


    nav a {

        font-size: 13px;

        padding:
            7px 9px;
    }
}

