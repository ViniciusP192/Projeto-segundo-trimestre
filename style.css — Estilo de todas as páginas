@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --azul: #2563eb;
    --azul-escuro: #172554;
    --verde: #16a34a;
    --roxo: #7c3aed;
    --fundo: #f4f7fb;
    --texto: #172033;
    --cinza: #64748b;
    --branco: #ffffff;
}

body {
    font-family: 'Inter', Arial, sans-serif;
    background: var(--fundo);
    color: var(--texto);
    line-height: 1.7;
}

/* HEADER */

header {
    width: 100%;
    padding: 18px 7%;
    background: rgba(255, 255, 255, 0.95);
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 15px rgba(0,0,0,0.06);
}

.logo {
    font-size: 20px;
    font-weight: 800;
    color: var(--azul-escuro);
}

nav {
    display: flex;
    gap: 10px;
}

nav a {
    color: #475569;
    text-decoration: none;
    font-weight: 600;
    padding: 9px 15px;
    border-radius: 8px;
    transition: 0.3s;
}

nav a:hover,
nav a.ativo {
    background: #dbeafe;
    color: var(--azul);
}

/* HERO */

.hero {
    min-height: 390px;
    padding: 70px 8%;
    background: linear-gradient(135deg, #172554, #2563eb);
    color: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
}

.hero > div:first-child {
    max-width: 720px;
}

.etiqueta {
    display: inline-block;
    background: rgba(255,255,255,0.15);
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(38px, 6vw, 68px);
    line-height: 1.05;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    opacity: 0.9;
}

.hero-icon,
.bola,
.robo {
    font-size: 130px;
    filter: drop-shadow(0 15px 20px rgba(0,0,0,0.25));
}

.hero-verde {
    background: linear-gradient(135deg, #052e16, #16a34a);
}

.hero-robo {
    background: linear-gradient(135deg, #3b0764, #7c3aed);
}

/* CONTEÚDO */

.conteudo,
.curiosidades,
.projetos {
    width: min(1100px, 90%);
    margin: 60px auto;
}

.card {
    background: var(--branco);
    padding: 35px;
    border-radius: 18px;
    margin-bottom: 25px;
    box-shadow: 0 8px 30px rgba(15,23,42,0.06);
}

.card h2 {
    color: var(--azul-escuro);
    margin-bottom: 15px;
    font-size: 25px;
}

.card p {
    color: var(--cinza);
    margin-bottom: 14px;
}

.destaque,
.alerta {
    padding: 18px;
    margin-top: 20px;
    border-radius: 12px;
    background: #eff6ff;
    border-left: 4px solid var(--azul);
}

.alerta {
    background: #fff7ed;
    border-left-color: #f97316;
}

/* FENÔMENOS */

.fenomenos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-top: 25px;
}

.fenomenos > div {
    background: #f8fafc;
    padding: 22px;
    border-radius: 14px;
}

.fenomenos span {
    font-size: 30px;
}

.fenomenos h3 {
    margin: 8px 0;
}

.fenomenos p {
    font-size: 14px;
}

/* FORMAÇÃO DA IMAGEM */

.imagem-exemplo {
    height: 180px;
    background: #0f172a;
    border-radius: 14px;
    margin: 25px 0;
    position: relative;
    overflow: hidden;
}

.lente {
    position: absolute;
    left: 50%;
    top: 40px;
    font-size: 70px;
    color: #60a5fa;
    transform: translateX(-50%);
}

.objeto {
    position: absolute;
    left: 18%;
    bottom: 45px;
    color: #22c55e;
    font-size: 45px;
}

.imagem {
    position: absolute;
    right: 18%;
    bottom: 45px;
    color: #ef4444;
    font-size: 45px;
}

/* TRIONDA */

.curiosidade {
    background: white;
    border-radius: 20px;
    padding: 35px;
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 30px;
    margin-bottom: 25px;
    box-shadow: 0 8px 30px rgba(15,23,42,0.06);
}

.numero {
    font-size: 42px;
    font-weight: 800;
    color: var(--verde);
}

.curiosidade h2 {
    margin-bottom: 10px;
}

.curiosidade p {
    color: var(--cinza);
}

.formula {
    display: inline-block;
    margin: 18px 0;
    padding: 12px 22px;
    border-radius: 10px;
    background: #f0fdf4;
    color: #15803d;
    font-size: 24px;
    font-weight: 700;
}

.trajetoria {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
    font-size: 35px;
}

.linha {
    width: 180px;
    height: 60px;
    border-top: 4px solid #22c55e;
    border-radius: 50%;
    transform: rotate(-10deg);
}

/* ROBÓTICA */

.projetos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.projeto,
.novo-projeto {
    background: white;
    padding: 30px;
    border-radius: 18px;
    box-shadow: 0 8px 30px rgba(15,23,42,0.06);
}

.icone {
    font-size: 55px;
    margin-bottom: 15px;
}

.projeto h2,
.novo-projeto h2 {
    margin-bottom: 10px;
}

.projeto p,
.novo-projeto p {
    color: var(--cinza);
}

.tag {
    display: inline-block;
    margin: 15px 5px 0 0;
    padding: 5px 10px;
    background: #ede9fe;
    color: #6d28d9;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
}

.novo-projeto {
    background: linear-gradient(135deg, #f5f3ff, #ede9fe);
    border: 2px dashed #8b5cf6;
}

button {
    border: none;
    margin-top: 18px;
    padding: 12px 20px;
    border-radius: 9px;
    background: var(--roxo);
    color: white;
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #5b21b6;
    transform: translateY(-2px);
}

#mensagem {
    margin-top: 15px;
    font-weight: 600;
    color: #6d28d9;
}

/* FOOTER */

footer {
    background: #0f172a;
    color: #94a3b8;
    text-align: center;
    padding: 30px;
    margin-top: 70px;
}

/* RESPONSIVIDADE */

@media (max-width: 700px) {

    header {
        flex-direction: column;
        gap: 15px;
    }

    nav {
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero {
        text-align: center;
        flex-direction: column;
        padding: 55px 7%;
    }

    .hero-icon,
    .bola,
    .robo {
        font-size: 80px;
    }

    .fenomenos,
    .projetos {
        grid-template-columns: 1fr;
    }

    .curiosidade {
        grid-template-columns: 1fr;
    }

    .numero {
        font-size: 30px;
    }
}

